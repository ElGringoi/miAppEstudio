# Firebase (Firebase Console → Configuración del proyecto)
# Todo lo que empieza con VITE_ termina en el bundle del navegador: acá solo va config pública.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Chat del Segundo Cerebro (función de Vercel api/cerebro-chat.ts)
# Van en Vercel → Settings → Environment Variables, NUNCA con prefijo VITE_.
# La función también lee VITE_FIREBASE_API_KEY para verificar el token de sesión.
GROQ_API_KEY=gsk_xxx
# Opcional: por defecto usa llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile
