# Config web de Firebase (Firebase Console → Project settings → Your apps).
# Es pública: Vite la mete en el bundle del navegador, y está bien así.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Solo servidor: se cargan en Vercel → Settings → Environment Variables.
# NUNCA con prefijo VITE_ (todo lo que empieza con VITE_ llega al navegador).
# Guía: docs/07-operaciones/segundo-cerebro.md
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
