# Firebase Configuration (from .env or Firebase Console)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Claude API Configuration (for Cloud Function)
# This should be stored securely in Firebase Functions environment variables
# NOT in the client .env
VITE_CLAUDE_API_KEY=sk-ant-xxx

# Cloud Function URL (for production deployment)
# Local development: http://localhost:5001/PROJECT_ID/us-central1/cerebro-chat
# Production: will be auto-deployed by Firebase
VITE_CLOUD_FUNCTION_URL=/api/cerebro-chat
